        let currentIdx = 0, score = 0, currentLives = config.maxLives;
        let timerInterval = null, timeLeft = config.timerDuration;
        let correctStreak = 0, maxStreak = 0, isAnswered = false;
        let earnedArtifacts = new Set(), earnedBadges = [];
        let studentName = &quot;&quot;, sessionStartTime, sessionTotalTime, blockStats = {};

        if(config.isResizable) {
            const card = $id(&quot;main-node&quot;);
            const header = $id(&quot;cardHeader&quot;);
            let isDragging = false, initialX, initialY, xOffset = 0, yOffset = 0;
            header.addEventListener(&quot;mousedown&quot;, (e) => { if(e.target === header || header.contains(e.target)) { initialX = e.clientX - xOffset; initialY = e.clientY - yOffset; isDragging = true; }});
            document.addEventListener(&quot;mouseup&quot;, () => { isDragging = false; });
            document.addEventListener(&quot;mousemove&quot;, (e) => { if(isDragging) { e.preventDefault(); xOffset = e.clientX - initialX; yOffset = e.clientY - initialY; card.style.transform = &quot;translate(&quot; + xOffset + &quot;px, &quot; + yOffset + &quot;px)&quot;; }});
        }

        W.startTrainer = function() {
            if(!runtimeTasks || runtimeTasks.length === 0) { alert(&quot;Заданий не найдено!&quot;); return; }
            studentName = $id(&quot;student-name&quot;).value.trim() || &quot;Студент&quot;;
            $id(&quot;screen-welcome&quot;).classList.remove(&quot;active&quot;);
            $id(&quot;screen-quiz&quot;).classList.add(&quot;active&quot;);
            sessionStartTime = Date.now();
            
            setInterval(() => {
                let diff = Math.floor((Date.now() - sessionStartTime) / 1000);
                let m = String(Math.floor(diff / 60)).padStart(2, &quot;0&quot;);
                let s = String(diff % 60).padStart(2, &quot;0&quot;);
                $id(&quot;header-timer&quot;).innerText = m + &quot;:&quot; + s;
            }, 1000);
            renderHP(); renderQuestion();
        };

        function renderHP() { $id(&quot;hud-lives&quot;).innerHTML = &quot;❤️&quot;.repeat(Math.max(0, currentLives)); }

        function renderQuestion() {
            isAnswered = false;
            $id(&quot;feedback-block&quot;).style.display = &quot;none&quot;;
            $id(&quot;hint-block&quot;).style.display = &quot;none&quot;;
            $id(&quot;next-action-btn&quot;).style.display = &quot;none&quot;;
            if(timerInterval) clearInterval(timerInterval);
            
            if(currentIdx >= runtimeTasks.length) { endSimulation(true); return; }

            const t = runtimeTasks[currentIdx];
            const aspectStr = t.aspectName || &quot;Задание&quot;;
            $id(&quot;hud-block-name&quot;).innerText = aspectStr;
            $id(&quot;hud-progress&quot;).innerText = currentIdx + 1 + &quot; / &quot; + runtimeTasks.length;
            
            if(!blockStats[aspectStr]) blockStats[aspectStr] = { total: 0, correct: 0, time: 0 };
            blockStats[aspectStr].total++;
            blockStats[aspectStr].questionStartTime = Date.now();

            let displayQ = t.q;
            if(t.question) displayQ += &quot;\n\n&quot; + t.question;
            $id(&quot;q-text&quot;).innerText = displayQ;
            
            const answers = [t.a];
            let dists = [];
            if (t.distractors &amp;&amp; t.distractors[config.distractorSetting]) {
                dists = t.distractors[config.distractorSetting];
            } else if (t.options &amp;&amp; Array.isArray(t.options)) {
                dists = t.options.filter(opt => opt !== t.a);
            }
            dists.forEach(d => { if(d &amp;&amp; !answers.includes(d) &amp;&amp; answers.length < 4) answers.push(d); });
            answers.sort(() => Math.random() - 0.5);

            const oBox = $id(&quot;options-box&quot;);
            oBox.innerHTML = &quot;&quot;;
            answers.forEach(ans => {
                const b = document.createElement(&quot;button&quot;);
                b.className = &quot;opt-btn&quot;; b.innerText = ans; b.onclick = () => verifyAnswer(ans, b);
                oBox.appendChild(b);
            });
            
            if(config.timerActive) { 
                timeLeft = config.timerDuration;
                $id(&quot;hud-timer&quot;).innerText = timeLeft;
                timerInterval = setInterval(() => {
                    if(!isAnswered) {
                        timeLeft--; $id(&quot;hud-timer&quot;).innerText = timeLeft < 10 ? &quot;0&quot; + timeLeft : timeLeft;
                        if(timeLeft <= 0) { clearInterval(timerInterval); verifyAnswer(&quot;&quot;, null); }
                    }
                }, 1000);
            }
        }

        function verifyAnswer(chosen, buttonEl) {
            if(isAnswered) return;
            isAnswered = true;
            if(timerInterval) clearInterval(timerInterval);

            const t = runtimeTasks[currentIdx];
            const aspectStr = t.aspectName || &quot;Задание&quot;;
            const duration = (Date.now() - blockStats[aspectStr].questionStartTime) / 1000;
            blockStats[aspectStr].time += duration;

            const fBlock = $id(&quot;feedback-block&quot;);
            root.querySelectorAll(&quot;.opt-btn&quot;).forEach(b => {
                b.disabled = true;
                if(b.innerText === t.a) { b.style.borderColor = &quot;#10b981&quot;; b.style.background = &quot;rgba(16,185,129,0.1)&quot;; }
            });
            
            if(config.hintsActive &amp;&amp; t.hint) {
                const hBlock = $id(&quot;hint-block&quot;);
                hBlock.innerHTML = &quot;<strong style=&#39;color:#00f2fe;&#39;>Пояснение: </strong>&quot; + t.hint;
                hBlock.style.display = &quot;block&quot;;
            }

            if(chosen === t.a) {
                score += 10;
                correctStreak++;
                if(correctStreak > maxStreak) maxStreak = correctStreak;
                if(config.aiAdaptive &amp;&amp; correctStreak >= config.streakThresh) score += 5;
                blockStats[aspectStr].correct++;
                
                $id(&quot;hud-score&quot;).innerText = &quot;Score: &quot; + score;
                fBlock.className = &quot;feedback-banner&quot;; fBlock.style.backgroundColor = &quot;rgba(16,185,129,0.2)&quot;; fBlock.style.color = &quot;#10b981&quot;;
                fBlock.innerText = &quot;🎉 Верно!&quot;;
                checkArtifactUnlock(score);
                $id(&quot;next-action-btn&quot;).style.display = &quot;block&quot;;
                $id(&quot;next-action-btn&quot;).innerText = (currentIdx === runtimeTasks.length - 1) ? &quot;Завершить&quot; : &quot;Далее&quot;;
            } else {
                correctStreak = 0;
                currentLives--; renderHP();
                fBlock.className = &quot;feedback-banner&quot;; fBlock.style.backgroundColor = &quot;rgba(255,51,102,0.2)&quot;; fBlock.style.color = &quot;#ff3366&quot;;
                fBlock.innerText = &quot;❌ Ошибка! Верно: &quot; + t.a;
                if(buttonEl) buttonEl.style.borderColor = &quot;#ff3366&quot;;
                
                if(currentLives <= 0) {
                    setTimeout(() => { endSimulation(false); }, 2000);
                } else {
                    if(config.repeatOnErr) {
                        isAnswered = false;
                        setTimeout(() => {
                            fBlock.style.display = &quot;none&quot;; $id(&quot;hint-block&quot;).style.display = &quot;none&quot;;
                            root.querySelectorAll(&quot;.opt-btn&quot;).forEach(b => { b.disabled = false; b.style.borderColor = &quot;rgba(255,255,255,0.1)&quot;; b.style.background = &quot;rgba(0,0,0,0.4)&quot;; });
                            if(config.timerActive) {
                                timeLeft = config.timerDuration; $id(&quot;hud-timer&quot;).innerText = timeLeft;
                                timerInterval = setInterval(() => {
                                    if(!isAnswered) { timeLeft--; $id(&quot;hud-timer&quot;).innerText = timeLeft < 10 ? &quot;0&quot; + timeLeft : timeLeft; if(timeLeft <= 0) { clearInterval(timerInterval); verifyAnswer(&quot;&quot;, null); } }
                                }, 1000);
                            }
                        }, 2000);
                    } else {
                        $id(&quot;next-action-btn&quot;).style.display = &quot;block&quot;;
                        $id(&quot;next-action-btn&quot;).innerText = (currentIdx === runtimeTasks.length - 1) ? &quot;Завершить&quot; : &quot;Далее&quot;;
                    }
                }
            }
            fBlock.style.display = &quot;block&quot;;
        }

        function checkArtifactUnlock(currentScore) {
            const foundArts = rewardsPool.filter(a => a.score <= currentScore);
            foundArts.forEach(art => {
                if(!earnedArtifacts.has(art.score)) {
                    earnedArtifacts.add(art.score);
                    if(config.artifactTiming === &quot;immediate&quot;) showArtifactPopup(art);
                }
            });
        }
        
        function showArtifactPopup(art) {
            const modal = $id(&quot;modal-game-box&quot;);
            const content = $id(&quot;modal-inner-content&quot;);
            content.style.maxWidth = &quot;330px&quot;; content.style.height = &quot;auto&quot;; content.style.alignItems = &quot;center&quot;; content.style.padding = &quot;20px&quot;; content.style.background = &quot;#161b2e&quot;;
            let clickBtn = art.link ? &quot;<button class=&#39;btn-action btn-full&#39; style=&#39;display:block; background: #10b981; color: white;&#39; onclick=&#39;window.&quot; + wID + &quot;.openGameFrame(\&quot;&quot; + art.link + &quot;\&quot;)&#39;>🎮 Играть сейчас!</button>&quot; : &quot;&quot;;
            content.innerHTML = &quot;<h2 style=&#39;color:white; margin-bottom:12px; text-align:center;&#39;>Новый Артефакт!</h2>&quot; +
                &quot;<div class=&#39;artifact-popup-card&#39;><img src=&#39;&quot; + art.img + &quot;&#39; style=&#39;width:100%; height:100%; object-fit:cover;&#39;></div>&quot; + clickBtn +
                &quot;<button class=&#39;btn-action btn-full&#39; style=&#39;display:block; color: white;&#39; onclick=&#39;window.&quot; + wID + &quot;.closeModal()&#39;>Продолжить</button>&quot;;
            modal.style.display = &quot;flex&quot;;
        }

        W.openGameFrame = function(url) {
            const modal = $id(&quot;modal-game-box&quot;);
            const content = $id(&quot;modal-inner-content&quot;);
            content.style.maxWidth = &quot;90%&quot; ; content.style.height = &quot;85vh&quot;; content.style.padding = &quot;0&quot;;
            content.innerHTML = &quot;<div class=&#39;game-modal-header&#39;><span style=&#39;font-weight:700; font-size:14px;&#39;>🎮 Игровая зона</span><button class=&#39;game-modal-close&#39; onclick=&#39;window.&quot; + wID + &quot;.closeModal()&#39;>✕</button></div>&quot; +
                &quot;<iframe class=&#39;game-modal-iframe&#39; src=&#39;&quot; + url + &quot;&#39; allow=&#39;autoplay; fullscreen&#39;></iframe>&quot;;
            modal.style.display = &quot;flex&quot;;
        };
        
        W.closeModal = function() { 
            $id(&quot;modal-game-box&quot;).style.display = &quot;none&quot;;
            $id(&quot;modal-inner-content&quot;).innerHTML = &quot;&quot;; 
        };
        
        W.advanceWorkflow = function() { currentIdx++; renderQuestion(); };

        function endSimulation(isWin) {
            if(timerInterval) clearInterval(timerInterval);
            sessionTotalTime = Math.floor((Date.now() - sessionStartTime) / 1000);
            $id(&quot;screen-quiz&quot;).classList.remove(&quot;active&quot;);
            $id(&quot;screen-results&quot;).classList.add(&quot;active&quot;);

            const percent = Math.round((blockStats &amp;&amp; Object.keys(blockStats).length > 0) ? 
                (Object.values(blockStats).reduce((a,b)=>a+b.correct,0) / runtimeTasks.length) * 100 : 0) || 0;

            $id(&quot;student-congrats&quot;).innerText = studentName + (isWin ? &quot;, тренировка завершена!&quot; : &quot;, жизни закончились!&quot;);
            $id(&quot;student-congrats&quot;).style.color = isWin ? &quot;#00f2fe&quot; : &quot;#ff3366&quot;;
            setTimeout(()=> { $id(&quot;final-progress&quot;).style.width = percent + &quot;%&quot;; }, 100);
            $id(&quot;stat-score&quot;).innerText = percent + &quot;%&quot;;
            $id(&quot;stat-total-time&quot;).innerText = sessionTotalTime + &quot;с&quot;;

            let timeReportHtml = &quot;<div style=&#39;font-weight:700; margin-bottom:6px;&#39;>⏱️ Среднее время ответа:</div>&quot;;
            let weakBlocks = [];
            for (let b in blockStats) {
                let avg = (blockStats[b].time / blockStats[b].total).toFixed(1);
                let acc = Math.round((blockStats[b].correct / blockStats[b].total) * 100);
                timeReportHtml += &quot;<div>• &quot; + b + &quot;: <b>&quot; + avg + &quot;с</b> (Точность: &quot; + acc + &quot;%)</div>&quot;;
                if(acc < 70) weakBlocks.push(b);
            }
            $id(&quot;time-by-blocks&quot;).innerHTML = timeReportHtml;
            
            let errorsReportHtml = &quot;&quot;;
            if(!isWin) {
                errorsReportHtml = &quot;<div class=&#39;feedback-advice&#39;>💀 Тест провален. Необходимо изучить теорию и попробовать снова!</div>&quot;;
            } else if(weakBlocks.length > 0) {
                errorsReportHtml = &quot;<div class=&#39;feedback-advice&#39;>💡 <b>Совет:</b> Обратите внимание на темы: <b>&quot; + weakBlocks.join(&quot;, &quot;) + &quot;</b>. Процент правильных ответов ниже нормы.</div>&quot;;
            } else if (percent < 100) {
                errorsReportHtml = &quot;<div class=&#39;feedback-advice&#39; style=&#39;border-color:#00f2fe; background:rgba(0,242,254,0.05); color:white;&#39;>💡 Отличный общий уровень! Перепроверьте ошибки, вызванные невнимательностью.</div>&quot;;
            } else {
                errorsReportHtml = &quot;<div class=&#39;feedback-advice&#39; style=&#39;border-color:#10b981; background:rgba(16,185,129,0.05); color:#10b981;&#39;>🏆 Идеально! Весь материал полностью освоен.</div>&quot;;
            }
            $id(&quot;feedback-analysis&quot;).innerHTML = errorsReportHtml;
            
            const badgesList = $id(&quot;badges-list&quot;);
            if(maxStreak >= 4 &amp;&amp; config.badgeStreak) earnedBadges.push(config.badgeStreak);
            if(percent === 100 &amp;&amp; config.badgePerfect) earnedBadges.push(config.badgePerfect);
            if(earnedBadges.length > 0) {
                $id(&quot;earned-badges-title&quot;).style.display = &quot;block&quot;;
                $id(&quot;share-btn&quot;).style.display = &quot;block&quot;;
                earnedBadges.forEach(b => {
                    const el = document.createElement(&quot;span&quot;); el.className = &quot;badge-item&quot;; el.innerText = b; badgesList.appendChild(el);
                });
            }

            if(config.artifactTiming === &quot;end&quot;) {
                const foundArts = rewardsPool.filter(a => a.score <= score);
                foundArts.forEach(art => earnedArtifacts.add(art.score));
            }
            let artifactsHTML = &quot;&quot;;
            rewardsPool.forEach(r => {
                if(earnedArtifacts.has(r.score)) {
                    let clickEvt = r.link ? &quot;onclick=&#39;window.&quot; + wID + &quot;.openGameFrame(\&quot;&quot; + r.link + &quot;\&quot;)&#39;&quot; : &quot;&quot;;
                    let cursorStyle = r.link ? &quot;cursor:pointer; border-color:#10b981;&quot; : &quot;&quot;;
                    let playBadge = r.link ? &quot;<span class=&#39;reward-play-badge&#39;>▶ Играть</span>&quot; : &quot;&quot;;
                    artifactsHTML += &quot;<div class=&#39;reward-icon-wrapper&#39; style=&#39;&quot; + cursorStyle + &quot;&#39; &quot; + clickEvt + &quot;><img src=&#39;&quot; + r.img + &quot;&#39;><span class=&#39;reward-badge&#39;>&quot; + r.score + &quot; XP</span>&quot; + playBadge + &quot;</div>&quot;;
                }
            });
            if(artifactsHTML) {
                $id(&quot;final-artifacts-shelf&quot;).innerHTML = artifactsHTML;
                $id(&quot;final-artifacts-shelf&quot;).style.paddingTop = &quot;15px&quot;;
            }

            const bonusContainer = $id(&quot;bonus-container&quot;);
            if(percent >= config.bonusThreshold) {
                bonusContainer.innerHTML = &quot;<div class=&#39;bonus-box&#39;>🔓 <b>Бонус разблокирован!</b><br><span style=&#39;font-size:14px; color:#ffd700; font-weight:bold;&#39;>&quot; + config.bonusContent + &quot;</span></div>&quot;;
            } else {
                bonusContainer.innerHTML = &quot;<div style=&#39;font-size:12px; color:rgba(255,255,255,0.7); text-align:center; margin-top:12px;&#39;>🔒 Наберите &quot; + config.bonusThreshold + &quot;% верных ответов, чтобы открыть бонус.</div>&quot;;
            }
        }

        W.shareResults = function() {
            const shareText = &quot;Я прошел тест &#39;&quot; + document.title + &quot;&#39; с результатом &quot; + score + &quot; XP! Мои бейджи: &quot; + earnedBadges.join(&quot;, &quot;);
            if (navigator.share) {
                navigator.share({ title: &quot;Учебные успехи&quot;, text: shareText, url: window.location.href }).catch(e => {});
            } else {
                window.open(&quot;mailto:?subject=Мои результаты&amp;body=&quot; + encodeURIComponent(shareText), &quot;_blank&quot;);
            }
        };
        
        W.resetTrainer = function() {
            currentIdx = 0; score = 0; currentLives = config.maxLives;
            correctStreak = 0; maxStreak = 0; isAnswered = false;
            earnedArtifacts = new Set(); earnedBadges = [];
            blockStats = {};
            $id(&quot;screen-results&quot;).classList.remove(&quot;active&quot;);
            $id(&quot;screen-quiz&quot;).classList.add(&quot;active&quot;);
            sessionStartTime = Date.now();
            renderHP(); renderQuestion();
        };
    })();
</script>
"></iframe>
</body>
</html>
